# ---------------------------------------------------------------
# NeuroTrace backend configuration. Copy to .env and adjust.
# ---------------------------------------------------------------
APP_ENV=development

# SQLite database (tables are created automatically on startup).
# Default: ./neurotrace.db next to this folder's app/ directory.
# DATABASE_URL=sqlite:///./neurotrace.db

# Uploaded handwriting images (served at /uploads/<file>).
# UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# CORS. Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Also allow http://localhost:<any port> and http://127.0.0.1:<any port> (handy with Vite).
CORS_ALLOW_LOCALHOST_ANY_PORT=true

# Demo / seed helpers
ENABLE_SEED_ENDPOINT=true        # POST /api/seed (turn off in production)
SEED_ON_STARTUP=false            # seed Aarav automatically at boot
# When true, ANY valid upload returns the canonical contract sample scores
# (clearly flagged in `warnings`). Useful for stage demos. Default false.
DEMO_ANALYSIS=false
# When true, unknown exercise_id values are rejected with 404.
STRICT_EXERCISE_IDS=true

# ---------------------------------------------------------------
# AI service (optional). With AI_ENABLED=false, or on ANY AI failure,
# the backend uses deterministic fallbacks and never returns an error
# just because the AI call failed.
# ---------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic            # anthropic | openai (openai = any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=                   # optional override, e.g. https://api.anthropic.com or http://localhost:11434
AI_TIMEOUT_SECONDS=20
